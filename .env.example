# Server
PORT=3000
NODE_ENV=development
# For dam-admin Vite use http://127.0.0.1:5173, or * for any origin.
# Comma-separated list also works, e.g.:
# CORS_ORIGIN=https://dam-admin-ten.vercel.app,http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN=*

# MongoDB Atlas (or local) connection string — required
MONGO_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/damic?retryWrites=true&w=majority

# JWT — required (use a long random string)
JWT_SECRET=change-me-to-a-long-random-secret

# Gemini (required for free-text FAQ chat)
GEMINI_API_KEY=
# Default: gemini-3.1-flash-lite (cheapest solid Flash-Lite; falls back to 3.5-flash-lite)
# GEMINI_MODEL=gemini-3.1-flash-lite

# Web Push VAPID keys (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Optional pause before AI replies (ms). Default ~900–1600. Set 0 to disable.
# CHAT_REPLY_DELAY_MS=1200
