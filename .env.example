# Server
PORT=3000
NODE_ENV=development
# For dam-admin Vite use http://127.0.0.1:5173, or * for any origin.
# Comma-separated list also works, e.g.:
# CORS_ORIGIN=https://dam-admin-ten.vercel.app,http://localhost:5173,http://127.0.0.1:5173
# Include marketing + admin Vercel URLs when not using *.\n# CORS_ORIGIN=https://munnawara-web.vercel.app,https://dam-admin-ten.vercel.app,http://localhost:5173\nCORS_ORIGIN=*

# MongoDB Atlas (or local) connection string — required
MONGO_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/damic?retryWrites=true&w=majority

# JWT — required (use a long random string)
JWT_SECRET=change-me-to-a-long-random-secret

# Gemini (required for free-text FAQ chat)
GEMINI_API_KEY=
# Default: gemini-3.1-flash-lite (cheapest solid Flash-Lite; falls back to 3.5-flash-lite)
# GEMINI_MODEL=gemini-3.1-flash-lite

# Web Push VAPID keys (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Optional pause before AI replies (ms). Default ~900–1600. Set 0 to disable.
# CHAT_REPLY_DELAY_MS=1200

# Chat inactivity auto-close (ms). Defaults: claimed 30m, needs_human 2h, AI 24h.
# CHAT_CLAIMED_IDLE_MS=1800000
# CHAT_NEEDS_HUMAN_IDLE_MS=7200000
# CHAT_AI_IDLE_MS=86400000
# CHAT_IDLE_SWEEP_MS=60000

# Reverse proxy in front of the API. Default "loopback" trusts nginx/caddy on the
# same machine so rate limits see the real visitor IP. Use a hop count (e.g. 1)
# if the proxy runs elsewhere.
# TRUST_PROXY=loopback

# Shared secret with munnawara-web (same value there). The website proxies chat
# through its own server; with this key the backend rate-limits per visitor IP
# instead of treating the whole website as one visitor.
# CHAT_PROXY_KEY=

# How often to check for quotes needing a reminder (ms). Default 5 minutes.
# The reply SLA and follow-up delay are set in admin Settings.
# QUOTE_REMINDER_SWEEP_MS=300000

# Public quote form spam limits (per 10 minutes). Defaults: 5 per phone, 60 per IP.
# The website submits from its own server, so the per-IP cap is only a high ceiling.
# QUOTE_MAX_PER_PHONE=5
# QUOTE_MAX_PER_IP=60

# Longest a chat reply may wait on Gemini, across all fallback models (ms). Default 20000.
# LLM_DEADLINE_MS=20000

# Chat messages and uploads must carry the customer's phone (proof they own the chat).
# Until this is 1, a request with no phone is still accepted and logged, for browsers
# running an older copy of the website. A wrong phone is always rejected.
# CHAT_REQUIRE_PHONE=1
