      "key": "adminEmail",
      "value": "admin@damic.local"
    },
    {
      "key": "adminPassword",
      "value": "changeme123"
    },
    {
      "key": "quoteId",
      "value": ""
    },
    {
      "key": "conversationId",
      "value": ""
