    {
      "name": "Quotes",
      "item": [
        {
          "name": "Create quote (public)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const data = pm.response.json();",
                  "  if (data.quote && data.quote._id) pm.collectionVariables.set('quoteId', data.quote._id);",
                  "  if (data.conversationId) pm.collectionVariables.set('conversationId', data.conversationId);",
                  "  if (data.quote && data.quote.customerContact) pm.collectionVariables.set('customerContact', data.quote.customerContact);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
