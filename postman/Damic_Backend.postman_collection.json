            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Jordan Lee\",\n  \"customerContact\": \"jordan@example.com\",\n  \"pickup\": \"JFK Airport\",\n  \"dropoff\": \"Manhattan Hotel\",\n  \"date\": \"2026-12-15T14:00:00.000Z\",\n  \"vehicleType\": \"sprinter\",\n  \"passengers\": 8,\n  \"notes\": \"Flight AA100\",\n  \"channel\": \"web\"\n}"
            },
            "url": "{{baseUrl}}/quotes",
            "description": "Public quote request. Creates Customer + Conversation + Quote.\n\nSaves `quoteId`, `conversationId`, `customerContact`.\n\nOptional `channel`: `web` | `whatsapp` | `phone` | `other`."
          },
