      "name": "Health",
      "item": [
        {
          "name": "GET Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "Full system health: database, sockets, LLM keys, Web Push.\n\nOverall `status`: `ok` | `degraded` | `error` (HTTP 503 if error)."
          },
          "response": [
            {
              "name": "OK / degraded",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/health"
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"status\": \"ok\",\n  \"uptimeSeconds\": 42,\n  \"timestamp\": \"2026-09-18T15:00:00.000Z\",\n  \"checks\": {\n    \"database\": {\n      \"status\": \"ok\",\n      \"readyState\": 1,\n      \"detail\": \"connected\"\n    },\n    \"sockets\": {\n      \"status\": \"ok\",\n      \"initialized\": true,\n      \"connections\": 2,\n      \"detail\": \"Socket.io ready\"\n    },\n    \"llm\": {\n      \"status\": \"ok\",\n      \"providers\": {\n        \"groq\": {\n          \"configured\": true,\n          \"reachable\": null\n        },\n        \"gemini\": {\n          \"configured\": false,\n          \"reachable\": null\n        }\n      }\n    },\n    \"push\": {\n      \"status\": \"ok\",\n      \"vapidConfigured\": true,\n      \"ready\": true\n    }\n  }\n}"
            }
          ]
        },
        {
          "name": "GET Health (deep probe)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health?deep=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ],
              "query": [
                {
                  "key": "deep",
                  "value": "1",
                  "description": "Ping Groq/Gemini APIs"
                }
              ]
            },
            "description": "Deep health: pings configured LLM providers. Slightly slower."
          },
          "response": [
            {
              "name": "Deep OK",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"status\": \"ok\",\n  \"checks\": {\n    \"llm\": {\n      \"status\": \"ok\",\n      \"providers\": {\n        \"groq\": {\n          \"configured\": true,\n          \"reachable\": true\n        }\n      }\n    }\n  }\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  if (data.token) {",
                  "    pm.collectionVariables.set('token', data.token);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Admin login. Returns JWT. On success, saves `token` to collection variables.\n\nSeed default (after `npm run seed:admin`): `admin@damic.local` / `changeme123`."
          },
          "response": [
            {
